# ── Backend ───────────────────────────────────────────────────────────────────

# Path where ask.db and uploads/ live.
# In production (Railway): set to your volume mount path, e.g. /data
DATA_DIR=

# JWT secret (legacy auth fallback)
JWT_SECRET=change-me-to-a-long-random-string

# Email (SMTP) — Gmail: use an App Password from myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=ASK YU Marketplace <your@gmail.com>

# Supabase — server only (never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend origin — set to your Vercel URL in production
FRONTEND_URL=https://your-app.vercel.app

# AI scheduling (Gemini free tier)
GEMINI_API_KEY=

# ── Frontend (Vite — must be prefixed VITE_) ──────────────────────────────────

# Backend URL in production — set to your Railway URL
# Leave blank in local dev (Vite proxy handles /api automatically)
VITE_API_URL=https://your-backend.up.railway.app/api

# OpenRouter — frontend concierge (Mistral 7B free tier)
VITE_OPENROUTER_KEY=

# Supabase — exposed to the browser (anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
